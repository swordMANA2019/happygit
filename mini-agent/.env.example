# 任意 OpenAI 兼容服务均可
OPENAI_API_KEY=xxxxxxx
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
AGENT_MODEL=glm-4-flash
AGENT_MAX_STEPS=25

# ---- 可选：稳健性相关 ----
# 覆盖自动探测的验证命令（exit 0 = 通过）
# AGENT_VERIFY_CMD=npm test
# 验证命令超时（毫秒）
# AGENT_VERIFY_TIMEOUT_MS=90000
# LLM 请求失败（429/5xx/网络）的最大重试次数 / 单次请求超时（毫秒）
# AGENT_LLM_RETRIES=4
# AGENT_LLM_TIMEOUT_MS=120000
# 对话上下文字符预算，超出后折叠较早的工具输出
# AGENT_CONTEXT_CHARS=220000
# 修复失败时保留 Agent 的改动而不是回滚（默认回滚）
# AGENT_KEEP_ON_FAIL=1
# 需要确认的高风险写操作（删除/新建配置文件等）自动放行；等价于启动参数 --yes。非交互环境下默认是"拒绝"
# AGENT_AUTO_APPROVE=1
# 允许 Agent 读写 .env / 私钥等凭据文件（默认禁止，因为内容会被发给 LLM 服务商）
# AGENT_ALLOW_SECRETS=1
